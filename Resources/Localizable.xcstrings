    "Starts this provider automatically for every new request. Turn it off to translate only from the result card." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפעיל את הספק הזה אוטומטית בכל בקשה חדשה. כבו את האפשרות כדי לתרגם רק מכרטיס התוצאה."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次新请求都会自动调用此服务。关闭后，仅在结果卡片中点击翻译时调用。"
          }
        }
      }
    },
