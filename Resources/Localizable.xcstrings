{
  "sourceLanguage" : "en",
  "strings" : {
    "HTTP Proxy" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרוקסי HTTP"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP 代理"
          }
        }
      }
    },
    "Use a custom HTTP proxy" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש בפרוקסי HTTP מותאם אישית"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自定义 HTTP 代理"
          }
        }
      }
    },
    "Proxy Host" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כתובת הפרוקסי"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理地址"
          }
        }
      }
    },
    "Proxy Port" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פורט הפרוקסי"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理端口"
          }
        }
      }
    },
    "For a local proxy, use 127.0.0.1 and its HTTP or mixed port. Authentication is not supported." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפרוקסי מקומי, יש להשתמש ב־127.0.0.1 ובפורט ה־HTTP או הפורט המשולב שלו. אימות אינו נתמך."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本地代理时，填写 127.0.0.1 及其 HTTP 或混合端口。暂不支持代理身份验证。"
          }
        }
      }
    },
    "Applies only to Google Translate. When disabled, existing system and per-app proxy routing is used." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חל רק על Google Translate. כשהאפשרות כבויה, נעשה שימוש בניתוב הפרוקסי הקיים של המערכת ושל כל אפליקציה."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于谷歌翻译。关闭时沿用系统及按应用代理的网络设置。"
          }
        }
      }
    },
    "Enter a proxy hostname or IP address without a scheme, path, or port." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להזין שם מארח או כתובת IP של הפרוקסי, ללא פרוטוקול, נתיב או פורט."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入代理主机名或 IP 地址，不要包含协议、路径或端口。"
          }
        }
      }
    },
    "Enter a proxy port between 1 and 65535." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להזין פורט פרוקסי בין 1 ל־65535."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入 1 至 65535 之间的代理端口。"
          }
        }
      }
    },
    "Connection successful" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור הצליח"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
